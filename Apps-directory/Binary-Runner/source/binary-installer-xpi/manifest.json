{
  "manifest_version": 2,
  "name": "Binary Runner Helper",
  "version": "1.0.8",
  "applications": {
    "gecko": {
      "id": "jscalated-binary-runner@local"
    }
  },
  "experiment_apis": {
    "binaryRunnerInstaller": {
      "schema": "schema.json",
      "parent": {
        "events": [
          "startup"
        ],
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "binaryRunnerInstaller"
          ]
        ],
        "script": "api.js"
      }
    }
  }
}
